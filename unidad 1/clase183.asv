%TP1
%% Lectura de archivo
clc; clear all; close all;
[file,dir]=uigetfile('.bmp;.tif;.jpg;.png');
filename=[dir,file];
info=imfinfo(filename);

switch info.ColorType
    case 'indexed'  %ImOrig.bmp
        [X,map]=imread(filename);
        I=ind2gray(X,map);

    case 'grayscale'
        I=imread(filename);

    case 'truecolor' %m83.bmp
        rgb=imread(filename);
        I=rgb2gray(rgb);
end

I = im2double(I); %trabaja normalizado
%%
%modifico brillo y contraste de la
R = 0.5 + I*0.25;

%Utilizo el comando imadjust
r_low = min(R(:));
r_high = max(R(:));

S = imadjust(R,[r_low r_high],[0 1]);

i_min = min(I(:));
i_max = max(I(:));
r_min = min(R(:));
r_max = max(R(:));



R = im2double(R);

r_min = min(R(:));
r_max = max(R(:));

% fijo los valores min y max de la salida
s_min = 50;
s_max = 100;

% pido al usuario ingreso los valores min y max de la salida
s_low  = input('Ingrese el valor min de S [0, 1]:\n');
s_high = input('Ingrese el valor max de S [0, 1]:\n');

r_low = min(R(:));
r_high = max(R(:));

S = imadjust(R, [r_low r_high], [s_low s_high]);
%% 7)Aplique a una imagen la transformación stretching utilizando el comando imadjust. Grafique ambos histogramas (original y procesado).

figure
subplot(321); imshow(I); title('Imagen original')
subplot(322); imhist(I), title(['Histo original, min=', num2str(i_min), ' max=', num2str(i_max)]); axis tight
subplot(323); imshow(R); title('Img modificada')
subplot(324); imhist(R), title(['Histo modificado , min=', num2str(r_min), ' max=', num2str(r_max)]); axis tight
subplot(325); imshow(S); title('Imagen con stretching')
subplot(326); imhist(S); title(['Histograma con stretching, min=', num2str(s_min), ' max=', num2str(s_max)]); axis tight